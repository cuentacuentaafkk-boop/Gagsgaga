-- Registra conexiones para limpiarlas al salir
local function AddConnection(conn)
    table.insert(GlobalConnections, conn)
    return conn
end

-- Limpia todas las conexiones al destruirse el script
local function CleanupConnections()
    for _, conn in ipairs(GlobalConnections) do
        if conn.Connected then
            conn:Disconnect()
        end
    end
    GlobalConnections = {}
end

-- Anima propiedades con tween
local function Tween(obj, props, time)
    time = time or 0.1
    if time == 0 then
        for k, v in pairs(props) do
            obj[k] = v
        end
        return
    end
    local info = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(obj, info, props)
    tween:Play()
    return tween
end

-- Aplica un color sólido o degradado a un objeto
local function ApplyColor(obj, colors, rotation)
    local existingGradient = obj:FindFirstChild("UIGradient")
    if existingGradient then
        existingGradient:Destroy()
    end

    if typeof(colors) == "Color3" then
        colors = { colors }
    end
    if not colors or #colors == 0 then
        return
    end

    if #colors == 1 then
        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            obj.ImageColor3 = colors[1]
        else
            obj.BackgroundColor3 = colors[1]
        end
        return
    end

    local gradient = Instance.new("UIGradient")
    gradient.Parent = obj
    gradient.Rotation = rotation or 0

    local keypoints = {}
    if #colors == 2 then
        keypoints = {
            ColorSequenceKeypoint.new(0, colors[1]),
            ColorSequenceKeypoint.new(1, colors[2]),
        }
    elseif #colors >= 3 then
        keypoints = {
            ColorSequenceKeypoint.new(0, colors[1]),
            ColorSequenceKeypoint.new(0.5, colors[2]),
            ColorSequenceKeypoint.new(1, colors[3]),
        }
    end
    gradient.Color = ColorSequence.new(keypoints)

    if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        obj.ImageColor3 = Color3.new(1, 1, 1)
    else
        obj.BackgroundColor3 = Color3.new(1, 1, 1)
    end
end

-- Convierte RGB a HSV
local function RGBtoHSV(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local max, min = math.max(r, g, b), math.min(r, g, b)
    local h, s, v = 0, 0, max
    local d = max - min
    s = (max == 0) and 0 or d / max
    if max == min then
        h = 0
    elseif max == r then
        h = (g - b) / d + (g < b and 6 or 0)
    elseif max == g then
        h = (b - r) / d + 2
    elseif max == b then
        h = (r - g) / d + 4
    end
    h = h / 6
    return h, s, v
end

-- Obtiene una propiedad de forma segura
local function SafeGet(obj, prop)
    local ok, val = pcall(function() return obj[tostring(prop)] end)
    return ok and val
end

-- Calcula el ancho del texto de un label
