-- Efecto ripple en botones
local function RippleEffect(button, x, y)
    task.spawn(function()
        button.ClipsDescendants = true
        local circle = PrefabCircle:Clone()
        circle.Parent = button
        circle.ZIndex = 1000
        circle.Position = UDim2.new(0, x - circle.AbsolutePosition.X, 0, y - circle.AbsolutePosition.Y)
        local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.5
        circle:TweenSizeAndPosition(
            UDim2.new(0, size, 0, size),
            UDim2.new(0.5, -size / 2, 0.5, -size / 2),
            Enum.EasingDirection.Out,
            Enum.EasingStyle.Quad,
            0.5,
            false
        )
        Tween(circle, { ImageTransparency = 1 }, 0.5)
        task.wait(0.5)
        circle:Destroy()
    end)
end

--============================================================
-- FORMATO DE VENTANAS
--============================================================
local function FormatWindows()
    local layout = Prefabs:FindFirstChild("UIListLayout"):Clone()
    layout.Parent = Windows
    local positions = {}
    for _, obj in ipairs(Windows:GetChildren()) do
        if not obj:IsA("UIListLayout") then
            positions[obj] = obj.AbsolutePosition
        end
    end
    layout:Destroy()
    for obj, pos in pairs(positions) do
        obj.Position = UDim2.new(0, pos.X, 0, pos.Y)
    end
end

function Library:FormatWindows()
    FormatWindows()
end

--============================================================
-- FUNCIÓN PRINCIPAL: AddWindow
--============================================================
function Library:AddWindow(title, options)
    WindowCount = WindowCount + 1
    local isDropdownOpen = false

    title = tostring(title or "New Window")
    options = typeof(options) == "table" and options or Config
    options.tween_time = options.tween_time or 0.1

    -- Colores por defecto
    options.title_bar = options.title_bar or { Color3.fromRGB(41, 74, 122) }
    if typeof(options.title_bar) == "Color3" then
        options.title_bar = { options.title_bar }
    end

    options.title_bar_transparency = options.title_bar_transparency or 0
    options.background = options.background or { Color3.new(0.08, 0.09, 0.1) }
    if typeof(options.background) == "Color3" then
        options.background = { options.background }
    end

    options.background_transparency = options.background_transparency or 0.1

    if not options.main_color then
        options.main_color = options.title_bar[1]
    end

    -- Escala según el tamaño del viewport
    local function scaleSize(size)
        local vp = workspace.CurrentCamera.ViewportSize
        local scale = 1
        if vp.X <= 768 then
            scale = 0.65
        elseif vp.X <= 1024 then
            scale = 0.8
        elseif vp.X <= 1920 then
            scale = 1.3
        else
            scale = 1.6
        end
        return Vector2.new(
            math.min(size.X * scale, vp.X),
            math.min(size.Y * scale, vp.Y * 0.8)
        )
    end

    options.min_size = scaleSize(options.min_size or Vector2.new(450, 450))

    -- Adaptar al cambio de tamaño de pantalla
    local lastViewport = workspace.CurrentCamera.ViewportSize
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local vp = workspace.CurrentCamera.ViewportSize
        if (vp - lastViewport).Magnitude > 50 then
            lastViewport = vp
            local newSize = scaleSize(Vector2.new(450, 450))
            if Window.AbsoluteSize.X < newSize.X or Window.AbsoluteSize.Y < newSize.Y then
                Window.Size = UDim2.new(0, newSize.X, 0, newSize.Y)
            end
        end
    end)

    local Window = Prefabs:FindFirstChild("Window"):Clone()
    Window.Parent = Windows
    Window:FindFirstChild("Title").Text = title
    Window.Size = UDim2.new(0, options.min_size.X, 0, options.min_size.Y)
    Window.ZIndex = Window.ZIndex + WindowCount * 10

    --========================================================
    -- CONFIGURAR BARRA SUPERIOR
    --========================================================
    do
        local bar = Window:FindFirstChild("Bar")
        local titleLabel = bar:FindFirstChild("Title")
        local toggle = bar:FindFirstChild("Toggle")
        local base = bar:FindFirstChild("Base")
        local top = bar:FindFirstChild("Top")
        local tabSelection = Window:FindFirstChild("TabSelection")
        local barHeight = 24
        local padY = (barHeight - 18) / 2

        bar.Size = UDim2.new(1, 0, 0, barHeight)
        bar.Position = UDim2.new(0, 0, 0, 0)

        if base then base:Destroy() end
        if top then top:Destroy() end

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 5)
        corner.Parent = bar

        if toggle then
            toggle.Position = UDim2.new(0, 5, 0, padY)
        end

        if titleLabel then
            titleLabel.Position = UDim2.new(0, 25, 0, padY)
            titleLabel.Size = UDim2.new(1, -30, 1, -padY * 2)
            titleLabel.TextXAlignment = Enum.TextXAlignment.Center
        end

        bar.BackgroundTransparency = options.title_bar_transparency
        ApplyColor(bar, options.title_bar, 0)

        if tabSelection then
            tabSelection.Size = UDim2.new(1, -30, 0, 22)
            tabSelection.Position = UDim2.new(0, 15, 0, 28)

            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 6)
            c.Parent = tabSelection

            tabSelection.ImageTransparency = 0.4
            ApplyColor(tabSelection, options.title_bar, 45)
        end

        Window.ImageTransparency = options.background_transparency
        ApplyColor(Window, options.background, 45)

        local tabs = Window:FindFirstChild("Tabs")
        toggle.MouseButton1Click:Connect(function()
            if tabs.Visible then
                tabs.Visible = false
                Tween(Window, { Size = UDim2.new(0, Window.AbsoluteSize.X, 0, barHeight) }, options.tween_time)
            else
                tabs.Visible = true
                Window.Size = UDim2.new(0, Window.AbsoluteSize.X, 0, options.min_size.Y)
            end
        end)
    end

    local resizer = Window:WaitForChild("Resizer")
    local windowAPI = {}
    Window.Draggable = true

    --========================================================
    -- REDIMENSIONAR
    --========================================================
    do
        local originalIcon = Mouse.Icon
        local hovering = false

        resizer.MouseEnter:Connect(function()
            Window.Draggable = false
            if options.can_resize then
                originalIcon = Mouse.Icon
            end
            hovering = true
        end)

        resizer.MouseLeave:Connect(function()
            hovering = false
            if options.can_resize then
                Mouse.Icon = originalIcon
            end
            Window.Draggable = true
        end)

        local holding = false
        local heartbeat

        AddConnection(UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                holding = true
                if hovering and resizer.Active and options.can_resize then
                    heartbeat = RunService.Heartbeat:Connect(function()
                        if not holding or not resizer.Active then
                            if heartbeat then
                                heartbeat:Disconnect()
                                heartbeat = nil
                            end
                            return
                        end
                        local m = GetMousePos()
                        local sx = math.max(options.min_size.X, m.X - Window.AbsolutePosition.X)
                        local sy = math.max(options.min_size.Y, m.Y - Window.AbsolutePosition.Y)
                        Window.Size = UDim2.new(0, sx, 0, sy)
                    end)
                end
            end
        end))

        AddConnection(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                holding = false
                if heartbeat then
                    heartbeat:Disconnect()
                    heartbeat = nil
                end
            end
        end))
    end

    --========================================================
    -- MINIMIZAR
    --========================================================
    do
        local toggle = Window:FindFirstChild("Bar"):FindFirstChild("Toggle")
        local minimized = false
        local busy = false
        local savedVisibility = {}
        local savedY = Window.AbsoluteSize.Y

        toggle.MouseButton1Click:Connect(function()
            if busy then return end
            busy = true

            if not minimized then
                savedVisibility = {}
                for _, tab in ipairs(Window:FindFirstChild("Tabs"):GetChildren()) do
                    savedVisibility[tab] = tab.Visible
                    tab.Visible = false
                end
                resizer.Active = false
                savedY = Window.AbsoluteSize.Y
                Tween(toggle, { Rotation = 0 }, options.tween_time)
                Tween(Window, { Size = UDim2.new(0, Window.AbsoluteSize.X, 0, 26) }, options.tween_time)
            else
                for tab, vis in pairs(savedVisibility) do
                    tab.Visible = vis
                end
                resizer.Active = true
                Tween(toggle, { Rotation = 0 }, options.tween_time)
                Tween(Window, { Size = UDim2.new(0, Window.AbsoluteSize.X, 0, savedY) }, options.tween_time)
            end

            minimized = not minimized
            task.delay(options.tween_time, function()
                busy = false
            end)
        end)
    end

    --========================================================
    -- SISTEMA DE TABS
    --========================================================
    do
        local tabsFrame = Window:FindFirstChild("Tabs")
        local tabSelection = Window:FindFirstChild("TabSelection")
        local tabScrolling = tabSelection:FindFirstChild("TabScrolling")
        local tabButtons = tabScrolling:FindFirstChild("TabButtons")
        local activeTab = nil
        local particleConn = nil

        local function updateTabsLayout()
            local width = 0
            local padding = tabButtons:FindFirstChildOfClass("UIListLayout").Padding.Offset or 0
            for _, btn in ipairs(tabButtons:GetChildren()) do
                if btn:IsA("TextButton") then
                    width = width + btn.AbsoluteSize.X + padding
                end
            end
            tabButtons.Size = UDim2.new(0, width, 1, 0)
            tabScrolling.CanvasSize = UDim2.new(0, width, 0, 0)
        end

        function windowAPI:AddTab(tabName)
            local tabAPI = {}
            tabName = tostring(tabName or "New Tab")
            tabSelection.Visible = true

            -- Crear botón de tab
            local tabButton = Prefabs:FindFirstChild("TabButton"):Clone()
            tabButton.Parent = tabButtons
            tabButton.Text = tabName
            tabButton.Size = UDim2.new(0, GetTextWidth(tabButton) + 20, 0, 18)
            tabButton.ZIndex = tabButton.ZIndex + WindowCount * 10
            tabButton.BackgroundTransparency = 1
            tabButton.TextColor3 = Color3.fromRGB(200, 200, 200)
            tabButton.TextSize = 13
            tabButton.Font = Enum.Font.FredokaOne

            local round = tabButton:GetChildren()[1]
            round.ZIndex = tabButton.ZIndex + WindowCount * 10
            round.ImageTransparency = 1

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 4)
            corner.Parent = tabButton

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.new(0, 0, 0)
            stroke.Thickness = 1.2
            stroke.Transparency = 0.7
            stroke.Parent = tabButton

            local outline = Instance.new("Frame")
            outline.Name = "TabOutline"
            outline.Size = UDim2.new(1, 0, 1, 0)
            outline.BackgroundTransparency = 1
            outline.BorderSizePixel = 2
            outline.BorderColor3 = options.main_color
            outline.ZIndex = tabButton.ZIndex + 10
            outline.Visible = false

            local oc = Instance.new("UICorner")
            oc.CornerRadius = UDim.new(0, 4)
            oc.Parent = outline
            outline.Parent = tabButton

            -- Crear contenedor del tab
            local tabContent = Prefabs:FindFirstChild("Tab"):Clone()
            tabContent.Parent = tabsFrame
            tabContent.ZIndex = tabContent.ZIndex + WindowCount * 10
            tabContent.Visible = false
            tabContent.ClipsDescendants = false
            tabContent.Size = UDim2.new(1, 0, 1, 0)
            tabContent.BackgroundTransparency = 1

            --====================================================
            -- SCROLLFRAME CON BARRA PILL PERSONALIZADA
            --====================================================
            local scroller = Instance.new("ScrollingFrame")
            scroller.Name = "TabScroller"
            scroller.Parent = tabContent
            scroller.Size = UDim2.new(1, -20, 1, 0)
            scroller.Position = UDim2.new(0, 0, 0, 0)
            scroller.BackgroundTransparency = 1
            scroller.BorderSizePixel = 0
            scroller.ScrollBarThickness = 0
            scroller.ScrollingEnabled = true
            scroller.ScrollingDirection = Enum.ScrollingDirection.Y
            scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
            scroller.AutomaticCanvasSize = Enum.AutomaticSize.None
            scroller.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
            scroller.ZIndex = tabContent.ZIndex
            scroller.Active = true
            scroller.Selectable = false
            scroller.ClipsDescendants = true

            local layout = tabContent:FindFirstChildOfClass("UIListLayout")
            if layout then
                layout.Parent = scroller
                layout.Padding = UDim.new(0, 5)
            end

            -- Barra de fondo (pill)
            local scrollBg = Instance.new("Frame")
            scrollBg.Name = "ScrollBg"
            scrollBg.Parent = tabContent
            scrollBg.AnchorPoint = Vector2.new(1, 0)
            scrollBg.Position = UDim2.new(1, -4, 0, 4)
            scrollBg.Size = UDim2.new(0, 8, 1, -8)
            scrollBg.BackgroundColor3 = Color3.fromRGB(41, 74, 122)
            scrollBg.BackgroundTransparency = 0.2
            scrollBg.BorderSizePixel = 0
            scrollBg.ZIndex = scroller.ZIndex + 50

            local bgCorner = Instance.new("UICorner")
            bgCorner.CornerRadius = UDim.new(1, 0)
            bgCorner.Parent = scrollBg

            -- Thumb (indicador que se mueve)
            local scrollThumb = Instance.new("Frame")
            scrollThumb.Name = "ScrollThumb"
            scrollThumb.Parent = scrollBg
            scrollThumb.Position = UDim2.new(0, 0, 0, 0)
            scrollThumb.Size = UDim2.new(1, 0, 0, 40)
            scrollThumb.BackgroundColor3 = Color3.fromRGB(80, 120, 180)
            scrollThumb.BorderSizePixel = 0
            scrollThumb.ZIndex = scrollBg.ZIndex + 1

            local thumbCorner = Instance.new("UICorner")
            thumbCorner.CornerRadius = UDim.new(1, 0)
            thumbCorner.Parent = scrollThumb

            -- Función que actualiza la barra
            local function updateScroll()
                if not layout then return end
                local content = layout.AbsoluteContentSize.Y + 10
                local visible = scroller.AbsoluteSize.Y
                scroller.CanvasSize = UDim2.new(0, 0, 0, content)

                if content <= visible then
                    scrollBg.Visible = false
                else
                    scrollBg.Visible = true
                    local ratio = visible / content
                    local thumbSize = math.max(30, scrollBg.AbsoluteSize.Y * ratio)
                    scrollThumb.Size = UDim2.new(1, 0, 0, thumbSize)

                    local maxScroll = content - visible
                    local scrollRatio = scroller.CanvasPosition.Y / maxScroll
                    local space = scrollBg.AbsoluteSize.Y - thumbSize
                    scrollThumb.Position = UDim2.new(0, 0, 0, space * scrollRatio)
                end
            end

            if layout then
                layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateScroll)
            end
            scroller:GetPropertyChangedSignal("CanvasPosition"):Connect(updateScroll)
            scroller:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScroll)

            task.spawn(function()
                task.wait(0.1)
                updateScroll()
            end)

            -- Drag del thumb
            local dragThumb = false
            local dragStartY = 0
            local startCanvasY = 0

            scrollThumb.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragThumb = true
                    dragStartY = input.Position.Y
                    startCanvasY = scroller.CanvasPosition.Y
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if not dragThumb then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                    local delta = input.Position.Y - dragStartY
                    local content = scroller.AbsoluteCanvasSize.Y
                    local visible = scroller.AbsoluteSize.Y
                    local maxScroll = math.max(1, content - visible)
                    local space = scrollBg.AbsoluteSize.Y - scrollThumb.AbsoluteSize.Y
                    if space <= 0 then return end
                    local scrollDelta = delta * (maxScroll / space)
                    local newY = math.clamp(startCanvasY + scrollDelta, 0, maxScroll)
                    scroller.CanvasPosition = Vector2.new(0, newY)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragThumb = false
                end
            end)

            -- Click en la pista
            scrollBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local ratio = (input.Position.Y - scrollBg.AbsolutePosition.Y) / scrollBg.AbsoluteSize.Y
                    local content = scroller.AbsoluteCanvasSize.Y
                    local visible = scroller.AbsoluteSize.Y
                    local maxScroll = math.max(0, content - visible)
                    scroller.CanvasPosition = Vector2.new(0, maxScroll * ratio)
                end
            end)

            -- Rueda del mouse
            scroller.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseWheel then
                    local delta = input.Position.Z * 40
                    local maxY = math.max(0, scroller.AbsoluteCanvasSize.Y - scroller.AbsoluteSize.Y)
                    local newY = math.clamp(scroller.CanvasPosition.Y - delta, 0, maxY)
                    scroller.CanvasPosition = Vector2.new(0, newY)
                end
            end)

            task.defer(updateTabsLayout)

            --====================================================
            -- PARTÍCULAS DEL TAB ACTIVO
            --====================================================
            local function emitParticles(btn)
                if btn ~= activeTab then return end
                local size = btn.AbsoluteSize
                for _ = 1, 3 do
                    task.spawn(function()
                        local p = Instance.new("Frame")
                        p.Size = UDim2.new(0, 1.5, 0, 1.5)
                        p.AnchorPoint = Vector2.new(0.5, 0.5)
                        p.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                        p.BorderSizePixel = 0
                        p.ZIndex = btn.ZIndex + 15

                        local c = Instance.new("UICorner")
                        c.CornerRadius = UDim.new(1, 0)
                        c.Parent = p

                        local side = math.random(1, 4)
                        local x, y = 0, 0
                        if side == 1 then
                            x = math.random(5, size.X - 5); y = 1
                        elseif side == 2 then
                            x = size.X - 1; y = math.random(5, size.Y - 5)
                        elseif side == 3 then
                            x = math.random(5, size.X - 5); y = size.Y - 1
                        else
                            x = 1; y = math.random(5, size.Y - 5)
                        end
                        p.Position = UDim2.new(0, x, 0, y)
                        p.Parent = btn

                        local cx, cy = size.X / 2, size.Y / 2
                        local dx, dy = x - cx, y - cy
                        local dist = math.sqrt(dx * dx + dy * dy)
                        dx, dy = dx / dist, dy / dist

                        local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                        local t = TweenService:Create(p, info, {
                            Position = UDim2.new(0, x + dx * 6, 0, y + dy * 6),
                            BackgroundTransparency = 1
                        })
                        t:Play()
                        task.wait(0.5)
                        if p and p.Parent then
                            p:Destroy()
                        end
                    end)
                end
            end

            local function startParticles()
                if particleConn then
                    particleConn:Disconnect()
                end
                particleConn = RunService.Heartbeat:Connect(function()
                    if activeTab and activeTab.Parent then
                        emitParticles(activeTab)
                        task.wait(0.2)
                    end
                end)
            end

            local function selectTab()
                if isDropdownOpen then return end
                if activeTab and activeTab ~= tabButton then
                    local prev = activeTab:FindFirstChild("TabOutline")
                    if prev then prev.Visible = false end
                    activeTab.TextColor3 = Color3.fromRGB(200, 200, 200)
                end

                for _, frame in ipairs(tabsFrame:GetChildren()) do
                    if frame:IsA("Frame") then
                        frame.Visible = false
                    end
                end

                activeTab = tabButton
                local outline = tabButton:FindFirstChild("TabOutline")
                if outline then
                    outline.Visible = true
                    outline.BorderColor3 = options.main_color
                end
                tabButton.TextColor3 = Color3.new(1, 1, 1)
                startParticles()
                tabContent.Visible = true

                task.spawn(function()
                    task.wait(0.05)
                    updateScroll()
                end)
            end

            tabButton.MouseButton1Click:Connect(selectTab)
            tabButton.MouseEnter:Connect(function()
                if tabButton ~= activeTab then
                    tabButton.TextColor3 = Color3.fromRGB(230, 230, 230)
                end
            end)
            tabButton.MouseLeave:Connect(function()
                if tabButton ~= activeTab then
                    tabButton.TextColor3 = Color3.fromRGB(200, 200, 200)
                end
            end)

            function tabAPI:Show()
                selectTab()
            end

            tabButton.AncestryChanged:Connect(function()
                if not tabButton.Parent and activeTab == tabButton then
                    activeTab = nil
                    if particleConn then
                        particleConn:Disconnect()
                        particleConn = nil
                    end
                end
            end)

            if #tabButtons:GetChildren() == 2 then
                selectTab()
            end

            --====================================================
            -- MÉTODOS DEL TAB
            --====================================================

            function tabAPI:AddLabel(text)
                text = tostring(text or "New Label")
                local label = Prefabs:FindFirstChild("Label"):Clone()
                label.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                label.Text = text
                label.Size = UDim2.new(0, GetTextWidth(label), 0, 20)
                label.ZIndex = label.ZIndex + WindowCount * 10
                task.spawn(function() task.wait(0.05); updateScroll() end)
                return label
            end

            function tabAPI:AddButton(text, callback)
                text = tostring(text or "New Button")
                callback = typeof(callback) == "function" and callback or function() end

                local btn = Prefabs:FindFirstChild("Button"):Clone()
                btn.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                btn.Text = text
                btn.Size = UDim2.new(0, GetTextWidth(btn), 0, 20)
                btn.ZIndex = btn.ZIndex + WindowCount * 10

                local round = btn:GetChildren()[1]
                round.ZIndex = round.ZIndex + WindowCount * 10
                round.ImageTransparency = options.title_bar_transparency or 0
                ApplyColor(round, { Color3.fromRGB(41, 74, 122) }, 0)
                btn.TextColor3 = Color3.new(1, 1, 1)

                btn.MouseButton1Click:Connect(function()
                    RippleEffect(btn, Mouse.X, Mouse.Y)
                    pcall(callback)
                end)

                task.spawn(function() task.wait(0.05); updateScroll() end)
                return btn
            end

            function tabAPI:AddSwitch(text, callback)
                local api = {}
                text = tostring(text or "New Switch")
                callback = typeof(callback) == "function" and callback or function() end

                local sw = Prefabs:FindFirstChild("Switch"):Clone()
                sw.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                sw:FindFirstChild("Title").Text = text
                sw:FindFirstChild("Title").ZIndex = sw:FindFirstChild("Title").ZIndex + WindowCount * 10
                sw.ZIndex = sw.ZIndex + WindowCount * 10

                local round = sw:GetChildren()[1]
                round.ZIndex = round.ZIndex + WindowCount * 10
                round.ImageTransparency = options.title_bar_transparency or 0
                ApplyColor(round, { Color3.fromRGB(41, 74, 122) }, 0)

                local state = false
                sw.MouseButton1Click:Connect(function()
                    state = not state
                    sw.Text = state and utf8.char(10003) or ""
                    pcall(callback, state)
                end)

                function api:Set(v)
                    state = typeof(v) == "boolean" and v or false
                    sw.Text = state and utf8.char(10003) or ""
                    pcall(callback, state)
                end

                task.spawn(function() task.wait(0.05); updateScroll() end)
                return api, sw
            end

            function tabAPI:AddTextBox(placeholder, callback, opts)
                placeholder = tostring(placeholder or "New TextBox")
                callback = typeof(callback) == "function" and callback or function() end
                opts = typeof(opts) == "table" and opts or { clear = false }
                opts.clear = opts.clear == true

                local tb = Prefabs:FindFirstChild("TextBox"):Clone()
                tb.Size = UDim2.new(0.5, -5, 0, 20)
                tb.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                tb.PlaceholderText = placeholder
                tb.ZIndex = tb.ZIndex + WindowCount * 10

                local round = tb:GetChildren()[1]
                round.ZIndex = round.ZIndex + WindowCount * 10
                round.ImageTransparency = options.title_bar_transparency or 0
                ApplyColor(round, { Color3.fromRGB(41, 74, 122) }, 0)

                tb.TextColor3 = Color3.new(1, 1, 1)
                tb.PlaceholderColor3 = Color3.fromRGB(200, 200, 200)

                tb.FocusLost:Connect(function(enter)
                    if enter and #tb.Text > 0 then
                        pcall(callback, tb.Text)
                        if opts.clear then
                            tb.Text = ""
                        end
                    end
                end)

                task.spawn(function() task.wait(0.05); updateScroll() end)
                return tb
            end

            function tabAPI:AddSlider(text, callback, opts)
                local api = {}
                text = tostring(text or "New Slider")
                callback = typeof(callback) == "function" and callback or function() end
                opts = typeof(opts) == "table" and opts or {}
                opts.min = opts.min or 0
                opts.max = opts.max or 100
                opts.readonly = opts.readonly or false

                local slider = Prefabs:FindFirstChild("Slider"):Clone()
                slider.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                slider.ZIndex = slider.ZIndex + WindowCount * 10

                local title = slider:FindFirstChild("Title")
                local indicator = slider:FindFirstChild("Indicator")
                local value = slider:FindFirstChild("Value")

                title.ZIndex = title.ZIndex + WindowCount * 10
                indicator.ZIndex = indicator.ZIndex + WindowCount * 10
                value.ZIndex = value.ZIndex + WindowCount * 10
                title.Text = text

                local hovering = false
                local heartbeat
                slider.MouseEnter:Connect(function()
                    hovering = true
                    Window.Draggable = false
                end)
                slider.MouseLeave:Connect(function()
                    hovering = false
                    Window.Draggable = true
                end)

                local holding = false
                UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        holding = true
                        if hovering and not opts.readonly then
                            heartbeat = RunService.Heartbeat:Connect(function()
                                if not holding or isDropdownOpen then
                                    if heartbeat then
                                        heartbeat:Disconnect()
                                        heartbeat = nil
                                    end
                                    return
                                end
                                local m = GetMousePos()
                                local ratio = math.clamp((m.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
                                indicator.Size = UDim2.new(ratio, 0, 0, 20)

                                local pct = math.floor(ratio * 100)
                                local range = opts.max - opts.min
                                local val = math.floor(range / 100 * pct + opts.min)
                                value.Text = tostring(val)
                                pcall(callback, val)
                            end)
                        end
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        holding = false
                        if heartbeat then
                            heartbeat:Disconnect()
                            heartbeat = nil
                        end
                    end
                end)

                function api:Set(v)
                    v = tonumber(v) or 0
                    v = math.clamp(v, 0, 100) / 100
                    indicator.Size = UDim2.new(v, 0, 0, 20)

                    local pct = math.floor(v * 100)
                    local range = opts.max - opts.min
                    local val = math.floor(range / 100 * pct + opts.min)
                    value.Text = tostring(val)
                    pcall(callback, val)
                end

                api:Set(opts.min)
                task.spawn(function() task.wait(0.05); updateScroll() end)
                return api, slider
            end

            function tabAPI:AddKeybind(text, callback, opts)
                local api = {}
                text = tostring(text or "New Keybind")
                callback = typeof(callback) == "function" and callback or function() end
                opts = typeof(opts) == "table" and opts or {}
                opts.standard = opts.standard or Enum.KeyCode.RightShift

                local kb = Prefabs:FindFirstChild("Keybind"):Clone()
                local input = kb:FindFirstChild("Input")
                local title = kb:FindFirstChild("Title")

                kb.ZIndex = kb.ZIndex + WindowCount * 10
                input.ZIndex = input.ZIndex + WindowCount * 10
                input:GetChildren()[1].ZIndex = input:GetChildren()[1].ZIndex + WindowCount * 10
                title.ZIndex = title.ZIndex + WindowCount * 10

                kb.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                title.Text = "  " .. text
                kb.Size = UDim2.new(0, GetTextWidth(title) + 80, 0, 20)

                local aliases = {
                    RightControl = "RightCtrl",
                    LeftControl = "LeftCtrl",
                    LeftShift = "LShift",
                    RightShift = "RShift",
                    MouseButton1 = "Mouse1",
                    MouseButton2 = "Mouse2",
                }
                local currentKey = opts.standard

                function api:SetKeybind(key)
                    input.Text = aliases[key.Name] or key.Name
                    currentKey = key
                end

                UserInputService.InputBegan:Connect(function(inputObj, gameProcessed)
                    if KeybindState.binding then
                        task.defer(function()
                            KeybindState.binding = false
                        end)
                        return
                    end
                    if inputObj.KeyCode == currentKey and not gameProcessed then
                        pcall(callback, currentKey)
                    end
                end)

                api:SetKeybind(opts.standard)

                input.MouseButton1Click:Connect(function()
                    if KeybindState.binding then return end
                    input.Text = "..."
                    KeybindState.binding = true
                    local key = UserInputService.InputBegan:Wait()
                    api:SetKeybind(key.KeyCode)
                end)

                task.spawn(function() task.wait(0.05); updateScroll() end)
                return api, kb
            end

            function tabAPI:AddDropdown(text, callback)
                local api = {}
                text = tostring(text or "New Dropdown")
                callback = typeof(callback) == "function" and callback or function() end

                local dd = Prefabs:FindFirstChild("Dropdown"):Clone()
                local box = dd:FindFirstChild("Box")
                local objects = box:FindFirstChild("Objects")
                local indicator = dd:FindFirstChild("Indicator")

                dd.ZIndex = dd.ZIndex + WindowCount * 10
                box.ZIndex = box.ZIndex + WindowCount * 10
                objects.ZIndex = objects.ZIndex + WindowCount * 10
                indicator.ZIndex = indicator.ZIndex + WindowCount * 10
                dd.Size = UDim2.new(0.5, -5, 0, 20)

                local round = dd:GetChildren()[3]
                round.ZIndex = round.ZIndex + WindowCount * 10
                round.ImageTransparency = options.title_bar_transparency or 0
                ApplyColor(round, { Color3.fromRGB(41, 74, 122) }, 0)

                box.ImageTransparency = options.background_transparency or 0.1
                ApplyColor(box, options.background, 0)

                local boxCorner = Instance.new("UICorner")
                boxCorner.CornerRadius = UDim.new(0, 6)
                boxCorner.Parent = box

                objects.BackgroundTransparency = 1
                objects.Position = UDim2.new(0, 0, 0, 0)
                objects.Size = UDim2.new(1, 0, 1, 0)

                dd.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                dd.Text = "      " .. text
                box.Size = UDim2.new(1, 0, 0, 0)
                box.Position = UDim2.new(0, 0, 0, 25)
                dd.TextColor3 = Color3.new(1, 1, 1)

                local open = false
                local flipUp = false

                dd.MouseButton1Click:Connect(function()
                    open = not open
                    local h = math.min((#objects:GetChildren() - 1) * 20, 200)

                    if #objects:GetChildren() - 1 >= 10 then
                        objects.CanvasSize = UDim2.new(0, 0, (#objects:GetChildren() - 1) * 0.1, 0)
                    end

                    if open then
                        if isDropdownOpen then return end
                        isDropdownOpen = true

                        local absY = dd.AbsolutePosition.Y
                        local hh = dd.AbsoluteSize.Y
                        local winBottom = Window.AbsolutePosition.Y + Window.AbsoluteSize.Y
                        local spaceBelow = winBottom - (absY + hh)

                        if spaceBelow < h then
                            flipUp = true
                            box.Position = UDim2.new(0, 0, 0, -h - 5)
                            box.Size = UDim2.new(1, 0, 0, 0)
                            local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            local t = TweenService:Create(box, info, {
                                Size = UDim2.new(1, 0, 0, h),
                                Position = UDim2.new(0, 0, 0, -h - 5),
                            })
                            t:Play()
                            Tween(indicator, { Rotation = -90 }, options.tween_time)
                        else
                            flipUp = false
                            box.Position = UDim2.new(0, 0, 0, 25)
                            box.Size = UDim2.new(1, 0, 0, 0)
                            Tween(box, { Size = UDim2.new(1, 0, 0, h) }, options.tween_time)
                            Tween(indicator, { Rotation = 90 }, options.tween_time)
                        end
                    else
                        isDropdownOpen = false
                        if flipUp then
                            local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            local t = TweenService:Create(box, info, {
                                Size = UDim2.new(1, 0, 0, 0),
                                Position = UDim2.new(0, 0, 0, -5),
                            })
                            t:Play()
                            t.Completed:Connect(function()
                                box.Position = UDim2.new(0, 0, 0, 25)
                            end)
                        else
                            Tween(box, { Size = UDim2.new(1, 0, 0, 0) }, options.tween_time)
                        end
                        Tween(indicator, { Rotation = -90 }, options.tween_time)
                    end
                end)

                function api:Add(option)
                    local optAPI = {}
                    option = tostring(option or "New Object")

                    local btn = Prefabs:FindFirstChild("DropdownButton"):Clone()
                    btn.Parent = objects
                    btn.Text = "      " .. option
                    btn.ZIndex = btn.ZIndex + WindowCount * 10 + 5
                    btn.BackgroundTransparency = 1
                    btn.TextColor3 = Color3.new(1, 1, 1)
                    btn.BorderSizePixel = 0
                    btn.TextXAlignment = Enum.TextXAlignment.Left

                    local c = btn:FindFirstChildOfClass("UICorner")
                    if c then c:Destroy() end

                    local stroke = Instance.new("UIStroke")
                    stroke.Color = Color3.new(0, 0, 0)
                    stroke.Thickness = 1
                    stroke.Transparency = 0.3
                    stroke.Parent = btn

                    btn.MouseEnter:Connect(function()
                        btn.BackgroundTransparency = 0.8
                        btn.BackgroundColor3 = Color3.fromRGB(41, 74, 122)
                    end)
                    btn.MouseLeave:Connect(function()
                        btn.BackgroundTransparency = 1
                    end)

                    if open then
                        local h = math.min((#objects:GetChildren() - 1) * 20, 200)
                        if #objects:GetChildren() - 1 >= 10 then
                            objects.CanvasSize = UDim2.new(0, 0, (#objects:GetChildren() - 1) * 0.1, 0)
                        end
                        if flipUp then
                            local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            local t = TweenService:Create(box, info, {
                                Size = UDim2.new(1, 0, 0, h),
                                Position = UDim2.new(0, 0, 0, -h - 5),
                            })
                            t:Play()
                        else
                            Tween(box, { Size = UDim2.new(1, 0, 0, h) }, options.tween_time)
                        end
                    end

                    btn.MouseButton1Click:Connect(function()
                        if isDropdownOpen then
                            dd.Text = "      [ " .. option .. " ]"
                            isDropdownOpen = false
                            open = false

                            if flipUp then
                                local info = TweenInfo.new(options.tween_time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                                local t = TweenService:Create(box, info, {
                                    Size = UDim2.new(1, 0, 0, 0),
                                    Position = UDim2.new(0, 0, 0, -5),
                                })
                                t:Play()
                                t.Completed:Connect(function()
                                    box.Position = UDim2.new(0, 0, 0, 25)
                                end)
                            else
                                Tween(box, { Size = UDim2.new(1, 0, 0, 0) }, options.tween_time)
                            end
                            Tween(indicator, { Rotation = -90 }, options.tween_time)
                            pcall(callback, option)
                        end
                    end)

                    function optAPI:Remove()
                        btn:Destroy()
                    end

                    task.spawn(function() task.wait(0.05); updateScroll() end)
                    return btn, optAPI
                end

                function api:Remove(option)
                    local obj = objects:FindFirstChild(option)
                    if obj then
                        obj:Destroy()
                        if api.currentSelection == option then
                            local first = objects:GetChildren()[1]
                            local val = first and first.Text or "No Selection"
                            api.currentSelection = val
                            dd.Text = "      [ " .. val .. " ]"
                            pcall(callback, val)
                        end
                    end
                end

                task.spawn(function() task.wait(0.05); updateScroll() end)
                return api, dd
            end

            function tabAPI:AddColorPicker(callback)
                local api = {}
                callback = typeof(callback) == "function" and callback or function() end

                local cp = Prefabs:FindFirstChild("ColorPicker"):Clone()
                cp.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                cp.ZIndex = cp.ZIndex + WindowCount * 10

                local palette = cp:FindFirstChild("Palette")
                local sample = cp:FindFirstChild("Sample")
                local saturation = cp:FindFirstChild("Saturation")

                palette.ZIndex = palette.ZIndex + WindowCount * 10
                sample.ZIndex = sample.ZIndex + WindowCount * 10
                saturation.ZIndex = saturation.ZIndex + WindowCount * 10

                local h, s, v = 0, 1, 1
                local function update()
                    local color = Color3.fromHSV(h, s, v)
                    sample.ImageColor3 = color
                    saturation.ImageColor3 = Color3.fromHSV(h, 1, 1)
                    pcall(callback, color)
                end
                update()

                local hoverP, hoverS = false, false
                palette.MouseEnter:Connect(function()
                    Window.Draggable = false
                    hoverP = true
                end)
                palette.MouseLeave:Connect(function()
                    Window.Draggable = true
                    hoverP = false
                end)
                saturation.MouseEnter:Connect(function()
                    Window.Draggable = false
                    hoverS = true
                end)
                saturation.MouseLeave:Connect(function()
                    Window.Draggable = true
                    hoverS = false
                end)

                local pi = palette:FindFirstChild("Indicator")
                local si = saturation:FindFirstChild("Indicator")
                pi.ZIndex = pi.ZIndex + WindowCount * 10
                si.ZIndex = si.ZIndex + WindowCount * 10

                local holding = false
                local heartbeat
                UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        holding = true
                        heartbeat = RunService.Heartbeat:Connect(function()
                            if not holding or isDropdownOpen then
                                if heartbeat then
                                    heartbeat:Disconnect()
                                    heartbeat = nil
                                end
                                return
                            end
                            if hoverP then
                                local m = GetMousePos()
                                local x = math.clamp((m.X - palette.AbsolutePosition.X) / palette.AbsoluteSize.X, 0, 1)
                                local y = math.clamp((m.Y - palette.AbsolutePosition.Y) / palette.AbsoluteSize.Y, 0, 1)
                                h = x
                                s = 1 - y
                                pi.Position = UDim2.new(x, -pi.AbsoluteSize.X / 2, y, -pi.AbsoluteSize.Y / 2)
                                update()
                            elseif hoverS then
                                local m = GetMousePos()
                                local y = math.clamp((m.Y - saturation.AbsolutePosition.Y) / saturation.AbsoluteSize.Y, 0, 1)
                                v = 1 - y
                                si.Position = UDim2.new(0, 0, y, 0)
                                update()
                            end
                        end)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        holding = false
                        if heartbeat then
                            heartbeat:Disconnect()
                            heartbeat = nil
                        end
                    end
                end)

                function api:Set(color)
                    color = typeof(color) == "Color3" and color or Color3.new(1, 1, 1)
                    local hh, ss, vv = RGBtoHSV(color.r * 255, color.g * 255, color.b * 255)
                    sample.ImageColor3 = color
                    saturation.ImageColor3 = Color3.fromHSV(hh, 1, 1)
                    pcall(callback, color)
                end

                task.spawn(function() task.wait(0.05); updateScroll() end)
                return api, cp
            end

            function tabAPI:AddHorizontalAlignment()
                local api = {}
                local frame = Prefabs:FindFirstChild("HorizontalAlignment"):Clone()
                frame.Parent = tabContent:FindFirstChild("TabScroller") or tabContent

                function api:AddButton(...)
                    local results = { tabAPI:AddButton(...) }
                    local obj = results[#results]
                    obj.Parent = frame
                    return table.unpack(results)
                end
                return api, frame
            end

            function tabAPI:AddFolder(folderName)
                local folderAPI = {}
                folderName = tostring(folderName or "New Folder")

                local folder = Prefabs:FindFirstChild("Folder"):Clone()
                local button = folder:FindFirstChild("Button")
                local objects = folder:FindFirstChild("Objects")
                local toggle = button:FindFirstChild("Toggle")

                folder.ZIndex = folder.ZIndex + WindowCount * 10
                button.ZIndex = button.ZIndex + WindowCount * 10
                objects.ZIndex = objects.ZIndex + WindowCount * 10
                toggle.ZIndex = toggle.ZIndex + WindowCount * 10
                button:GetChildren()[1].ZIndex = button:GetChildren()[1].ZIndex + WindowCount * 10

                folder.Parent = tabContent:FindFirstChild("TabScroller") or tabContent
                button.Text = "      " .. folderName
                button:GetChildren()[1].ImageColor3 = Color3.fromRGB(41, 74, 122)

                local function calcHeight()
                    local total = 25
                    for _, child in ipairs(objects:GetChildren()) do
                        if not child:IsA("UIListLayout") then
                            total = total + child.AbsoluteSize.Y + 5
                        end
                    end
                    return total
                end

                local open = false
                local heartbeat
                button.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        Tween(toggle, { Rotation = 90 }, options.tween_time)
                        objects.Visible = true
                        if heartbeat then heartbeat:Disconnect() end
                        heartbeat = RunService.Heartbeat:Connect(function()
                            if open then
                                folder.Size = UDim2.new(1, 0, 0, calcHeight())
                            else
                                if heartbeat then
                                    heartbeat:Disconnect()
                                    heartbeat = nil
                                end
                            end
                        end)
                    else
                        Tween(toggle, { Rotation = 0 }, options.tween_time)
                        objects.Visible = false
                        folder.Size = UDim2.new(1, 0, 0, 20)
                        if heartbeat then
                            heartbeat:Disconnect()
                            heartbeat = nil
                        end
                    end
                    task.spawn(function() task.wait(0.05); updateScroll() end)
                end)

                for name, fn in pairs(tabAPI) do
                    folderAPI[name] = function(...)
                        local results = { fn(...) }
                        local obj = results[#results]
                        obj.Parent = objects
                        return table.unpack(results)
                    end
                end

                task.spawn(function() task.wait(0.05); updateScroll() end)
                return folderAPI, folder
            end

            return tabAPI, tabContent
        end
    end

    for _, descendant in ipairs(Window:GetDescendants()) do
        if SafeGet(descendant, "ZIndex") then
            descendant.ZIndex = descendant.ZIndex + WindowCount * 10
        end
    end

    return windowAPI, Window
end

script.AncestryChanged:Connect(function()
    if not script.Parent then
        CleanupConnections()
    end
end)

return Library
